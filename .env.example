ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Model providers ---------------------------------------------------------
# Any *_MODEL setting takes an optional "provider:model" prefix, so the same
# call_llm() path can reach Anthropic, OpenAI, Ollama Cloud (or a local Ollama)
# and OpenCode Go. A value with no prefix uses DEFAULT_PROVIDER. Only the first
# colon splits, which is what keeps Ollama tags intact: "ollama:gemma4:31b"
# resolves to provider=ollama, model="gemma4:31b".
#
# Everything below is optional — an empty override just means "use the default
# in docs/model-provider-config.md", which is also the capability table and the
# reference for the error messages. Switching backends is a .env change, not a
# code change; the five *_MODEL settings keep their current defaults.
DEFAULT_PROVIDER=anthropic

# 1) Anthropic native. Unchanged behaviour: ANTHROPIC_API_KEY above is enough,
#    and a bare model name still routes here through DEFAULT_PROVIDER.
#    Copy as-is to spell it out:
#      DEFAULT_PROVIDER=anthropic
#      RESEARCH_MODEL=anthropic:claude-haiku-5-5
# ANTHROPIC_BASE_URL is optional; set it only to aim the Anthropic SDK at
# another anthropic_messages-compatible endpoint (e.g. an Ollama or OpenCode
# entry exposed through a proxy you control).
ANTHROPIC_BASE_URL=

# 2) Ollama Cloud. Two provider names share OLLAMA_API_KEY because the gateway
#    serves both API families: "ollama" speaks Chat Completions, "ollama-anthropic"
#    speaks Messages. STRUCTURED_OUTPUT picks how a response schema is enforced
#    (native | json_mode | prompt_only); Ollama defaults to json_mode because its
#    json_schema support is uneven. PRICING_MODE is per_token | subscription |
#    unknown; leave it unknown unless you have real per-token rates.
#    Copy as-is, leaving OLLAMA_BASE_URL empty for https://ollama.com/v1:
#      DEFAULT_PROVIDER=ollama
#      OLLAMA_API_KEY=your-ollama-cloud-key
#      RESEARCH_MODEL=ollama:gemma4:31b
#    Local Ollama needs no new provider — just override the base_url, and give
#    OLLAMA_API_KEY any non-empty value because Ollama ignores it:
#      OLLAMA_BASE_URL=http://localhost:11434/v1
#      OLLAMA_API_KEY=ollama
#      DEFAULT_PROVIDER=ollama
#      RESEARCH_MODEL=ollama:gemma4:31b
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_STRUCTURED_OUTPUT=json_mode
OLLAMA_PRICING_MODE=unknown

# 3) OpenCode Go / Console. Same two-entry split as Ollama: "opencode" speaks
#    Chat Completions (GLM / Kimi / DeepSeek / Qwen / MiniMax), "opencode-anthropic"
#    speaks Messages (Claude family). OpenCode assigns the family per model, so
#    choosing a provider name replaces a model->family table; both entries share
#    OPENCODE_API_KEY, so you only need one key.
#    Copy as-is:
#      DEFAULT_PROVIDER=opencode
#      OPENCODE_API_KEY=your-opencode-go-key
#      RESEARCH_MODEL=opencode:glm-5.3
#    Claude models through that same key take the -anthropic entry:
#      RESEARCH_MODEL=opencode-anthropic:claude-haiku-5-5
#    Models served only over the Responses API are not supported yet; the ones
#    above are (see the "non-goals" section of the doc).
OPENCODE_BASE_URL=
OPENCODE_API_KEY=
OPENCODE_STRUCTURED_OUTPUT=prompt_only
OPENCODE_PRICING_MODE=subscription

# WARNING — the USD budget does not bind on flat-rate plans. Ollama reports
# pricing_mode=unknown and OpenCode pricing_mode=subscription, and both make
# est_usd = 0 for every call, so RESEARCH_MAX_USD (below) never trips on them:
# that cap only ever sees per-token spend. On Ollama/OpenCode the real bound is
# RESEARCH_MAX_ITERATIONS (default 3), so lower it if you want a tighter leash.

# Postgres credentials — read by docker-compose.yml to initialize the
# container, and embedded in DATABASE_URL below for the app/asyncpg (which
# needs the full connection URL, not the parts separately). If you change
# these, update DATABASE_URL to match.
POSTGRES_USER=substack_brain
POSTGRES_PASSWORD=substack_brain_pw
POSTGRES_DB=substack_brain
DATABASE_URL=postgresql+asyncpg://substack_brain:substack_brain_pw@localhost:5433/substack_brain

INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288
# For Inngest Cloud (https://app.inngest.com), set INNGEST_DEV=0,
# INNGEST_BASE_URL=https://api.inngest.com, and provide your Cloud keys:
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
LAB_PORT=8000
USER_AGENT=substack-brain/0.1 (+https://github.com/neural-maze/substack-brain-course)

# Chunking — max characters per passage, and how many characters repeat
# between consecutive passages (see docs/week-1.md Step 6 for why overlap
# matters). Re-ingest existing articles after changing these; passages
# already persisted keep their old boundaries.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# How many of a feed's most recent entries add-publication fans out to
# ingest-article. Deliberately small for week 1 ("one newsletter, five
# articles"). Unused from week 2 on: backfill-publication takes the whole feed.
DISCOVERY_LIMIT=5

# Week 2 flow control for ingest-article (see docs/week-2.md).
# CONCURRENCY_PER_PUBLICATION: articles from the same publication in flight at
# once. INGEST_RUNS_PER_MINUTE: run starts per minute across all publications,
# roughly one OpenAI embedding request each. For the queue-jump demo, set them
# to 1 and 10 so the queue lasts long enough to watch.
CONCURRENCY_PER_PUBLICATION=3
INGEST_RUNS_PER_MINUTE=50

# PRIORITY_BACKFILL_S: Inngest priority time shift in seconds for backfill runs (-600..600).
# Default (-600) schedules backfill runs 10 minutes later in queue, allowing manual
# POST /articles submissions (+600) to jump ahead. Set to 0 if you want backfill/poll
# runs to start immediately without a 10-minute wait during development.
PRIORITY_BACKFILL_S=-600

# Week 4 Memgraph connection (Bolt protocol; Memgraph Lab UI runs on http://localhost:3000)
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=


# Week 5 evaluation suite (binary LLM judges need ANTHROPIC_API_KEY; deterministic checks do not)
EVAL_JUDGE_MODEL=claude-haiku-5-5
EVAL_JUDGE_MAX_TOKENS=1024
# Max concurrent run-eval-suite executions
CONCURRENCY_EVAL_RUNS=2
# Minimum TPR/TNR a judge must reach on the labeled traces to be considered calibrated
EVAL_MIN_TPR=0.90
EVAL_MIN_TNR=0.90

# Week 6 bounded research agent & weekly digest
RESEARCH_MODEL=claude-haiku-5-5
RESEARCH_MAX_ITERATIONS=3
RESEARCH_MAX_USD=0.25
CONCURRENCY_RESEARCH_RUNS=2
DIGEST_CRON=0 8 * * 1
DIGEST_LOOKBACK_DAYS=7
